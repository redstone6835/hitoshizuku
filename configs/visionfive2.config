# VisionFive 2 板级构建配置。PLIC 与启动存储链内建，其余外设按需装载。
CONFIG_FIRMWARE_BUS=y
CONFIG_LOONGSON_IRQ=n
CONFIG_RISCV_PLIC=y
CONFIG_RISCV_PMU=m
CONFIG_RISCV_IOMMU=n
CONFIG_DT_PROVIDERS=y
CONFIG_JH7110_CRG=y
CONFIG_JH7110_PINCTRL=y
CONFIG_JH7110_UART=y
CONFIG_JH7110_MMC=y
CONFIG_JH7110_TRNG=m
CONFIG_LOONGSON_CLK=n
CONFIG_LOONGSON_PINCTRL_GPIO=n
CONFIG_PLATFORM_AHCI=n
CONFIG_LOONGSON_APBDMA=n
CONFIG_LOONGSON_SDIO=n
CONFIG_PCI_HOST_ECAM=m
CONFIG_SYSCON=m
CONFIG_LS2K_GMAC=n
CONFIG_LS2K_TSENSOR=n
CONFIG_LS2K_USB=n
CONFIG_LS2K_I2C=n
CONFIG_LS2K_SPI=n
CONFIG_LS2X_WDT=n
CONFIG_LS2K_RTC=n
CONFIG_LS7A_RTC=n
CONFIG_GOLDFISH_RTC=n
CONFIG_FW_CFG=n
CONFIG_CFI_FLASH=n
CONFIG_UART16550=n
CONFIG_RANDOM=y
CONFIG_NET_STACK=y
CONFIG_NET_LOOPBACK=y
CONFIG_LANGUAGE_RUNTIME=y
CONFIG_VIRTIO=n
CONFIG_VIRTIO_BLK=n
CONFIG_VIRTIO_NET=n
