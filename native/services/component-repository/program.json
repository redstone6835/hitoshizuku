{
  "manifest_version": 1,
  "abi_epoch": 1,
  "entry": "_start",
  "imports": [
    { "operation": "process.exit", "required": true },
    { "operation": "handle.close", "required": true },
    { "operation": "image.create", "required": true },
    { "operation": "image.query", "required": true },
    { "operation": "memory.allocate", "required": true },
    { "operation": "memory.free", "required": true },
    { "operation": "directory.open", "required": true },
    { "operation": "file.read", "required": true },
    { "operation": "file.query", "required": true },
    { "operation": "channel.send", "required": true },
    { "operation": "channel.receive", "required": true }
  ],
  "capabilities": [
    { "requirement": "self_process", "rights": ["exit", "create"], "required": true },
    { "requirement": "current_address_space", "rights": ["allocate", "free"], "required": true },
    { "requirement": "root_directory", "rights": ["open", "inspect"], "required": true },
    {
      "requirement": "service_channel",
      "rights": ["send", "receive", "observe"],
      "required": true
    }
  ],
  "runtime": {
    "stack_size": 65536,
    "stack_guard_size": 4096,
    "start_info_max_size": 4096
  }
}
