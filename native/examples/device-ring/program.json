{
  "manifest_version": 1,
  "abi_epoch": 1,
  "entry": "_start",
  "imports": [
    { "operation": "handle.close", "required": true },
    { "operation": "process.exit", "required": true },
    { "operation": "stream.write", "required": true },
    { "operation": "memory.create", "required": true },
    { "operation": "memory.map", "required": true },
    { "operation": "memory.unmap", "required": true },
    { "operation": "memory.revoke", "required": true },
    { "operation": "ring.create", "required": true },
    { "operation": "ring.register", "required": true },
    { "operation": "ring.unregister", "required": true },
    { "operation": "ring.kick", "required": true },
    { "operation": "ring.wait", "required": true },
    { "operation": "device.invoke", "required": true },
    { "operation": "device.query", "required": true }
  ],
  "capabilities": [
    {
      "requirement": "self_process",
      "rights": ["create", "exit"],
      "required": true
    },
    {
      "requirement": "current_address_space",
      "rights": ["allocate", "free"],
      "required": true
    },
    {
      "requirement": "device_function",
      "rights": ["submit", "map", "inspect"],
      "required": true
    },
    { "requirement": "stdout", "rights": ["write"], "required": true }
  ],
  "runtime": {
    "stack_size": 65536,
    "stack_guard_size": 4096,
    "start_info_max_size": 4096
  }
}
