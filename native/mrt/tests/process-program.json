{
  "manifest_version": 1,
  "abi_epoch": 1,
  "entry": "_start",
  "imports": [
    { "operation": "handle.close", "required": true },
    { "operation": "stream.write", "required": true },
    { "operation": "image.create", "required": true },
    { "operation": "process.spawn", "required": true },
    { "operation": "process.wait", "required": true },
    { "operation": "event.create", "required": true },
    { "operation": "event.bind", "required": true },
    { "operation": "event.wait", "required": true }
  ],
  "capabilities": [
    {
      "requirement": "self_process",
      "rights": ["create", "spawn", "wait"],
      "required": true
    },
    {
      "requirement": "stdout",
      "rights": ["write"],
      "required": true
    }
  ],
  "runtime": {
    "stack_size": 65536,
    "stack_guard_size": 4096,
    "start_info_max_size": 4096
  }
}
