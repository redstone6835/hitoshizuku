#!/sbin/openrc-run

description="Generate /etc/resolv.conf from MyGO DHCP DNS"

depend() {
	# DHCP is started by the kernel network stack, so wait for the basic
	# filesystem services and use the bounded poll below for the lease.
	after localmount procfs sysfs
}

start() {
	local wait=75 dns tmp

	# Do not replace an administrator-provided resolver configuration. A file
	# previously generated by this service is safe to refresh on the next boot.
	if [ -s /etc/resolv.conf ] &&
		! grep -q '^# Generated by MyGO init (DHCP lease)$' /etc/resolv.conf; then
		return 0
	fi

	while [ "$wait" -gt 0 ]; do
		dns=$(cat /proc/net/dns 2>/dev/null)
		if [ -n "$dns" ]; then
			tmp="/run/.mygo-resolv.conf.$$"
			{
				echo "# Generated by MyGO init (DHCP lease)"
				printf '%s\n' "$dns"
			} > "$tmp" || return 0
			chmod 0644 "$tmp"
			if mv -f "$tmp" /etc/resolv.conf; then
				echo "[mygo-resolv] generated /etc/resolv.conf from DHCP"
			fi
			return 0
		fi
		sleep 1
		wait=$((wait - 1))
	done

	ewarn "DHCP DNS was not available; /etc/resolv.conf was not generated"
	return 0
}
