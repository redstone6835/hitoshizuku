#!/bin/sh

PATH=/sbin:/bin:/usr/sbin:/usr/bin
export PATH

echo "[init] Welcome to Shiori"

for dir in /dev /sys /proc /var /var/log /run /mnt /tmp; do
    [ -d "$dir" ] || mkdir -p "$dir"
    echo "[init] mkdir $dir OK"
done

mount -t proc proc /proc 2>/dev/null || true
echo "[init] mount /proc OK"

mount -t sysfs sysfs /sys 2>/dev/null || true
echo "[init] mount /sys OK"

mount -t devtmpfs devtmpfs /dev 2>/dev/null || true
echo "[init] mount /dev OK"

if [ -x /sbin/mdev ]; then
    if [ -e /proc/sys/kernel/hotplug ]; then
        echo /sbin/mdev > /proc/sys/kernel/hotplug 2>/dev/null || true
    fi
    /sbin/mdev -s 2>/dev/null || true
fi

maybe_enter_shell() {
    key_file="/tmp/init-key.$$"

    echo "[init] press Ctrl+C within 3 seconds to enter shell"
    trap 'echo "[init] Ctrl+C detected, entering shell"; exec /bin/sh -i' INT
    old_stty="$(stty -g < /dev/console 2>/dev/null || true)"
    stty raw -echo < /dev/console 2>/dev/null || true
    ( dd bs=1 count=1 of="$key_file" < /dev/console 2>/dev/null ) &
    key_pid=$!
    sleep 3
    if kill -0 "$key_pid" 2>/dev/null; then
        kill "$key_pid" 2>/dev/null || true
        wait "$key_pid" 2>/dev/null || true
    else
        wait "$key_pid" 2>/dev/null || true
    fi
    [ -n "$old_stty" ] && stty "$old_stty" < /dev/console 2>/dev/null || true
    trap - INT

    key_code="$(od -An -tu1 "$key_file" 2>/dev/null | tr -d '[:space:]')"
    if [ "$key_code" = "3" ]; then
        rm -f "$key_file"
        echo "[init] Ctrl+C detected, entering shell"
        exec /bin/sh -i
    fi
    rm -f "$key_file"
}

# 测试黑名单
# basic busybox lua libctest libcbench netperf lmbench ltp unixbench cyclictest iperf iozone
BLACKLIST="unixbench"

LTP_TIMEOUT="${LTP_TIMEOUT:-1}"
LTP_KILL_GRACE="${LTP_KILL_GRACE:-1}"
LTP_SKIP_CASES="${LTP_SKIP_CASES:-accept03 clone07 clock_nanosleep01 clock_nanosleep02 clock_nanosleep03 clock_nanosleep04 crash01 crash02 crypto_user01 crypto_user02 fcntl14 fcntl14_64 fcntl15 fcntl15_64 fcntl18 fcntl18_64 fcntl19_64 fcntl31 futex_cmp_requeue01 genacos genasin genatan genatan2 genbessel genceil gencos gencosh genexp genexp_log genfabs genfloor genfmod genfrexp genhypot geniperb genj0 genj1 genldexp genlgamma genload genlog genlog10 genmodf genpow genpower gensin gensinh gensqrt gentan gentanh gentrigo geny0 geny1 hackbench kill09 mmap3 mmapstress01 mmapstress02 mmapstress03 mmapstress04 mmapstress05 mmapstress06 mmapstress07 mmapstress08 mmapstress09 mmapstress10 mmstress mmstress_dummy modify_ldt01 modify_ldt02 modify_ldt03 pcrypt_aead01 splice07 syslog12 symlinkat01 waitid05 waitpid10 waitpid11 waitpid12 waitpid13 pthserv}"
export LTP_TIMEOUT LTP_KILL_GRACE

_is_blacklisted() {
    for _bl in $BLACKLIST; do
        case "$1" in
            *${_bl}*) return 0 ;;
        esac
    done
    return 1
}

_test_setup() {
    if [ -e /dev/tty ] && [ ! -L /dev/tty ]; then
        mv /dev/tty /dev/tty.real
    fi
    ln -sf /dev/null /dev/tty
}

_test_teardown() {
    rm -f /dev/tty
    [ -e /dev/tty.real ] && mv /dev/tty.real /dev/tty
}

setup_basic_mount_loop() {
    img="/tmp/basic-vda2.fat"
    state="/tmp/basic-vda2.loop"
    loopdev=""

    if [ -f "$state" ] || [ -L /dev/vda2 ]; then
        cleanup_basic_mount_loop >/dev/null 2>&1 || true
    fi
    rm -f "$img"

    if ! command -v losetup >/dev/null 2>&1 || ! command -v mkfs.vfat >/dev/null 2>&1; then
        echo "[init] basic mount loop skipped: losetup or mkfs.vfat missing"
        return 0
    fi

    truncate -s 64M "$img" 2>/dev/null || dd if=/dev/zero of="$img" bs=1M count=64 2>/dev/null || {
        echo "[init] basic mount loop skipped: cannot create image"
        return 0
    }
    mkfs.vfat -F 32 "$img" >/dev/null 2>&1 || mkfs.vfat "$img" >/dev/null 2>&1 || {
        echo "[init] basic mount loop skipped: mkfs.vfat failed"
        rm -f "$img"
        return 0
    }

    loopdev="$(losetup -f 2>/dev/null || true)"
    if [ -z "$loopdev" ]; then
        echo "[init] basic mount loop skipped: no free loop device"
        rm -f "$img"
        return 0
    fi
    losetup "$loopdev" "$img" >/dev/null 2>&1 || {
        echo "[init] basic mount loop skipped: losetup failed"
        rm -f "$img"
        return 0
    }

    ln -sf "$loopdev" /dev/vda2 2>/dev/null || {
        echo "[init] basic mount loop skipped: cannot link /dev/vda2"
        losetup -d "$loopdev" >/dev/null 2>&1 || true
        rm -f "$img"
        return 0
    }

    echo "$loopdev" >"$state" 2>/dev/null || true
    echo "[init] basic mount loop ready: /dev/vda2 -> $loopdev"
}

cleanup_basic_mount_loop() {
    img="/tmp/basic-vda2.fat"
    state="/tmp/basic-vda2.loop"
    loopdev=""

    if [ ! -f "$state" ] && [ ! -L /dev/vda2 ]; then
        return 0
    fi

    if [ -f "$state" ]; then
        loopdev="$(cat "$state" 2>/dev/null || true)"
    fi
    if [ -z "$loopdev" ] && [ -L /dev/vda2 ]; then
        loopdev="$(readlink /dev/vda2 2>/dev/null || true)"
    fi

    rm -f /dev/vda2 "$state"
    if [ -n "$loopdev" ]; then
        losetup -d "$loopdev" >/dev/null 2>&1 || true
    fi
    rm -f "$img"
}

kill_ltp_case_group() {
    target="$1"
    child="$2"

    kill -TERM "$target" 2>/dev/null || true
    kill -TERM "$child" 2>/dev/null || true
    kill -KILL "$target" 2>/dev/null || true
    kill -KILL "$child" 2>/dev/null || true
}

run_ltp_case() {
    file="$1"
    name="${file##*/}"
    marker="/tmp/ltp-case-timeout.$$"
    status="/tmp/ltp-case-status.$$"

    for skip in $LTP_SKIP_CASES; do
        if [ "$name" = "$skip" ]; then
            echo "RUN LTP CASE $name"
            echo "[ltp] 跳过会卡住 runner 的用例：$name"
            echo "FAIL LTP CASE $name : 124"
            return 0
        fi
    done

    rm -f "$marker" "$status"
    echo "RUN LTP CASE $name"

    if command -v setsid >/dev/null 2>&1; then
        setsid /bin/sh -c '"$1"; echo "$?" > "$2"' sh "$file" "$status" &
        child=$!
        kill_target="-$child"
    else
        /bin/sh -c '"$1"; echo "$?" > "$2"' sh "$file" "$status" &
        child=$!
        kill_target="$child"
    fi

    elapsed=0
    while [ ! -f "$status" ]; do
        if [ "$elapsed" -ge "$LTP_TIMEOUT" ]; then
            echo "[ltp] 用例超时：$name，超过 ${LTP_TIMEOUT}s"
            : >"$marker"
            kill_ltp_case_group "$kill_target" "$child"

            grace=0
            while [ "$grace" -lt "$LTP_KILL_GRACE" ] && [ ! -f "$status" ]; do
                sleep 1
                grace=$((grace + 1))
            done

            if [ ! -f "$status" ]; then
                echo "[ltp] 用例已终止但未回收，继续后续用例：$name"
                rm -f "$marker" "$status"
                echo "FAIL LTP CASE $name : 124"
                return 0
            fi
            break
        fi
        sleep 1
        elapsed=$((elapsed + 1))
    done

    ret="$(cat "$status" 2>/dev/null || echo 124)"
    kill_ltp_case_group "$kill_target" "$child"
    wait "$child" 2>/dev/null || true

    if [ -f "$marker" ]; then
        ret=124
    fi
    rm -f "$marker" "$status"
    echo "FAIL LTP CASE $name : $ret"
    return 0
}

run_ltp_script() {
    script="$1"
    libc_name="${PWD##*/}"
    target_dir="ltp/testcases/bin"

    echo "#### OS COMP TEST GROUP START ltp-$libc_name ####"
    if [ ! -d "$target_dir" ]; then
        echo "[ltp] LTP 目录不完整：$PWD/$target_dir"
        echo "#### OS COMP TEST GROUP END ltp-$libc_name ####"
        return 0
    fi

    echo "[init] 使用 ${script##*/} 触发 LTP，逐用例超时 ${LTP_TIMEOUT}s，跳过：$LTP_SKIP_CASES"
    for file in "$target_dir"/*; do
        if [ -f "$file" ]; then
            run_ltp_case "$file"
        fi
    done

    echo "#### OS COMP TEST GROUP END ltp-$libc_name ####"
    return 0
}

run_test_scripts() {
    _test_setup
    for dir in /mnt/glibc /mnt/musl; do
        set -- "$dir"/*_testcode.sh
        if [ -f "$1" ]; then
            echo "[init] found test scripts in $dir"
            cd "$dir" || continue
            for script in "$@"; do
                name="${script##*/}"
                if _is_blacklisted "$name"; then
                    echo "[init] skip $name (blacklist)"
                else
                    if [ "$name" = "basic_testcode.sh" ]; then
                        setup_basic_mount_loop
                    fi
                    echo "[init] run $name"
                    if [ "$name" = "ltp_testcode.sh" ]; then
                        run_ltp_script "$script"
                    else
                        /bin/sh "$script"
                    fi
                fi
                if [ "$name" = "busybox_testcode.sh" ]; then
                    cleanup_basic_mount_loop
                fi
            done
            cleanup_basic_mount_loop
        fi
    done
    _test_teardown
    return 0
}

setup_dynamic_linker() {
    glibc_lib=/mnt/glibc/lib

    if [ ! -e /lib ] && [ ! -L /lib ]; then
        ln -s "$glibc_lib" /lib 2>/dev/null || true
    fi
    if [ ! -e /lib64 ] && [ ! -L /lib64 ]; then
        ln -s "$glibc_lib" /lib64 2>/dev/null || true
    fi

    case ":${LD_LIBRARY_PATH:-}:" in
        *:"$glibc_lib":*) ;;
        *) LD_LIBRARY_PATH="$glibc_lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" ;;
    esac
    export LD_LIBRARY_PATH

    echo "[init] dynamic linker path prepared"
}

shutdown_after_tests() {
    sync || true
    poweroff -f >/dev/null 2>&1 || poweroff >/dev/null 2>&1 || reboot -f >/dev/null 2>&1 || true
}

mount -t ext4 /dev/vd0 /mnt 2>/dev/null || true
maybe_enter_shell
setup_dynamic_linker
echo "[init] mount testdisk OK (or skipped)"
echo "[init] ls /mnt:"
/bin/ls /mnt/ 2>&1 || true
echo "[init] ls done"

if run_test_scripts; then
    echo "[init] test scripts finished, shutting down"
    shutdown_after_tests
fi

echo "[init] no test scripts found, entering shell"
exec /bin/sh -i
