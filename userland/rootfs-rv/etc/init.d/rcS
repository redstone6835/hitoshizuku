#!/bin/sh

PATH=/sbin:/bin:/usr/sbin:/usr/bin
export PATH

echo "[init] Welcome to Shiori"

for dir in /dev /sys /proc /run /mnt /tmp; do
    [ -d "$dir" ] || mkdir -p "$dir"
done

mount -t devtmpfs devtmpfs /dev 2>/dev/null || true
mount -t proc proc /proc 2>/dev/null || true
mount -t sysfs sysfs /sys 2>/dev/null || true

if [ -x /sbin/mdev ]; then
    if [ -e /proc/sys/kernel/hotplug ]; then
        echo /sbin/mdev > /proc/sys/kernel/hotplug 2>/dev/null || true
    fi
    /sbin/mdev -s 2>/dev/null || true
fi

if [ -x /bin/pthread-smp-test ]; then
    echo "[init][smp-tests] running pthread SMP tests"
    /bin/pthread-smp-test
    status=$?
    echo "[init][smp-tests] pthread SMP tests exit=$status"
fi

if [ -x /bin/acct-test ]; then
    echo "[init][acct-tests] running process accounting tests"
    /bin/acct-test record
    record_status=$?
    /bin/acct-test verify "$record_status"
    status=$?
    echo "[init][acct-tests] process accounting tests exit=$status"
fi

enter_shell=0
trap 'enter_shell=1' INT
echo "[init] press Ctrl+C within 3 seconds to enter shell"
/bin/init-keywait 3000
keywait_status=$?
trap - INT

if [ "$enter_shell" -eq 1 ] || [ "$keywait_status" -eq 0 ]; then
    echo "[init] Ctrl+C detected, entering shell"
    exec /bin/sh -i
fi
if [ "$keywait_status" -ne 1 ]; then
    echo "[init] Ctrl+C detector failed with status $keywait_status; continuing tests"
fi

shutdown_system() {
    status=$1
    sync
    echo "[init] powering off with test status $status"
    poweroff -f >/dev/null 2>&1 || poweroff >/dev/null 2>&1 || \
        reboot -f >/dev/null 2>&1 || true
    exit "$status"
}

if ! mount -t ext4 /dev/vd0 /mnt; then
    echo "[init] failed to mount /dev/vd0 at /mnt"
    shutdown_system 1
fi

echo "[init] mounted /dev/vd0 at /mnt"

# CAgent 必须在测试盘自己的 glibc 根环境中运行。
mkdir -p /mnt/proc /mnt/sys /mnt/dev /mnt/tmp
mount -t proc proc /mnt/proc 2>/dev/null || true
mount -t sysfs sysfs /mnt/sys 2>/dev/null || true
mount -t devtmpfs devtmpfs /mnt/dev 2>/dev/null || true

runner=/mnt/tmp/.shiori-run-cagent-tests
if ! cp /etc/init.d/run-glibc-tests "$runner"; then
    echo "[init] failed to install CAgent test runner"
    shutdown_system 1
fi
chmod 0755 "$runner" 2>/dev/null || true

echo "[init] switching to the glibc test root"
chroot /mnt /bin/bash /tmp/.shiori-run-cagent-tests
status=$?

rm -f "$runner"
echo "[init] CAgent tests finished with status $status"
shutdown_system "$status"
