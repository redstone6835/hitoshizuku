#!/bin/bash

ulimit -c 0 2>/dev/null || true
export PATH=/root/.cargo/bin:/usr/local/bin:/usr/bin:/bin:/sbin:/usr/sbin
export HOME=/root

echo "[init] starting glibc CAgent tests"

# 官方脚本的裸 wait 会等待常驻 LLM 服务，导致结束标记和清理逻辑不可达。
# 临时副本只收集测试进程、修正等待对象并传播失败状态，不改变测试内容。
cagent_script=/glibc/cagent_testcode.sh
cagent_rewritten=/tmp/.shiori-cagent-testcode.sh
cagent_failure_file=/tmp/.shiori-cagent-failed

if [ ! -r "$cagent_script" ]; then
    echo "[init] CAgent test script is missing: $cagent_script"
    exit 1
fi

rm -f "$cagent_failure_file" "$cagent_rewritten"
if ! awk '
    NR == 1 {
        print
        print "CAGENT_FAILURE_FILE=/tmp/.shiori-cagent-failed"
        print "CAGENT_WAIT_STATUS=0"
        print "CAGENT_TEST_PIDS="
        next
    }
    /^[[:space:]]*wait[[:space:]]*$/ {
        print "for pid in $CAGENT_TEST_PIDS; do"
        print "    wait \"$pid\" || CAGENT_WAIT_STATUS=1"
        print "done"
        next
    }
    /^[[:space:]]*kill[[:space:]]+\$SERVER_PID/ {
        print "kill -KILL \"$SERVER_PID\" 2>/dev/null || true"
        print "wait \"$SERVER_PID\" 2>/dev/null || true"
        next
    }
    {
        if ($0 ~ /echo "testcase cagent .* reject/) {
            print "        : > \"$CAGENT_FAILURE_FILE\""
        }
        print
        if ($0 ~ /^[[:space:]]*[0-9]+[[:space:]]*&[[:space:]]*$/) {
            print "CAGENT_TEST_PIDS=\"$CAGENT_TEST_PIDS $!\""
        }
    }
    END {
        print "if [ \"$CAGENT_WAIT_STATUS\" -ne 0 ] || [ -e \"$CAGENT_FAILURE_FILE\" ]; then"
        print "    rm -f \"$CAGENT_FAILURE_FILE\""
        print "    exit 1"
        print "fi"
        print "rm -f \"$CAGENT_FAILURE_FILE\""
        print "exit 0"
    }
' "$cagent_script" > "$cagent_rewritten"; then
    echo "[init] failed to prepare CAgent test"
    rm -f "$cagent_failure_file" "$cagent_rewritten"
    exit 1
fi

if [ ! -s "$cagent_rewritten" ]; then
    echo "[init] prepared CAgent test is empty"
    rm -f "$cagent_failure_file" "$cagent_rewritten"
    exit 1
fi

cd /glibc || exit 1
/bin/bash "$cagent_rewritten"
status=$?

rm -f "$cagent_failure_file" "$cagent_rewritten"
echo "[init] CAgent tests finished with status $status"
exit "$status"
