#!/bin/sh

PATH=/sbin:/bin:/usr/sbin:/usr/bin
export PATH

echo "[init] Welcome to Shiori"

for dir in /dev /sys /proc /run /mnt /tmp; do
    [ -d "$dir" ] || mkdir -p "$dir"
done

mount -t devtmpfs devtmpfs /dev 2>/dev/null || true
mount -t proc proc /proc 2>/dev/null || true
mount -t sysfs sysfs /sys 2>/dev/null || true

if [ -x /sbin/mdev ]; then
    if [ -e /proc/sys/kernel/hotplug ]; then
        echo /sbin/mdev > /proc/sys/kernel/hotplug 2>/dev/null || true
    fi
    /sbin/mdev -s 2>/dev/null || true
fi

if [ -x /bin/pthread-smp-test ]; then
    echo "[init][smp-tests] running pthread SMP tests"
    /bin/pthread-smp-test
    status=$?
    echo "[init][smp-tests] pthread SMP tests exit=$status"
fi

if mount -t ext4 /dev/vd0 /mnt; then
    echo "[init] mounted /dev/vd0 at /mnt"
    sh_file_list="/tmp/init-sh-files.$$"
    : > "$sh_file_list"

    echo "[init] /mnt directory tree:"
    find /mnt -print 2>/dev/null | sort | while IFS= read -r path; do
        printf '%s\n' "$path"
        case "$path" in
            *.sh)
                if [ -f "$path" ] && [ ! -L "$path" ]; then
                    printf '%s\n' "$path" >> "$sh_file_list"
                fi
                ;;
        esac
    done
    echo "[init] /mnt directory tree end"

    if [ -s "$sh_file_list" ]; then
        echo "[init] shell file contents:"
        while IFS= read -r script; do
            printf '\n[init] ===== %s =====\n' "$script"
            cat "$script" || echo "[init] failed to read $script"
            printf '\n[init] ===== end %s =====\n' "$script"
        done < "$sh_file_list"
    else
        echo "[init] no .sh files found under /mnt"
    fi

    rm -f "$sh_file_list"
else
    echo "[init] failed to mount /dev/vd0 at /mnt"
fi

echo "[init] startup inspection complete"
