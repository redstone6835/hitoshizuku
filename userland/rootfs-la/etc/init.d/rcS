#!/bin/sh

PATH=/sbin:/bin:/usr/sbin:/usr/bin
export PATH

echo "[init] Welcome to Shiori"

for dir in /dev /sys /proc /var /var/log /run /mnt /tmp; do
    [ -d "$dir" ] || mkdir -p "$dir"
    echo "[init] mkdir $dir OK"
done

mount -t proc proc /proc 2>/dev/null || true
echo "[init] mount /proc OK"

mount -t sysfs sysfs /sys 2>/dev/null || true
echo "[init] mount /sys OK"

mount -t devtmpfs devtmpfs /dev 2>/dev/null || true
echo "[init] mount /dev OK"

if [ -x /sbin/mdev ]; then
    if [ -e /proc/sys/kernel/hotplug ]; then
        echo /sbin/mdev > /proc/sys/kernel/hotplug 2>/dev/null || true
    fi
    /sbin/mdev -s 2>/dev/null || true
fi

# 测试黑名单
# basic busybox lua libctest libcbench netperf lmbench ltp unixbench cyclictest iperf iozone
BLACKLIST="iozone libctest libcbench lmbench ltp unixbench"

_is_blacklisted() {
    for _bl in $BLACKLIST; do
        case "$1" in
            *${_bl}*) return 0 ;;
        esac
    done
    return 1
}

_test_setup() {
    if [ -e /dev/tty ] && [ ! -L /dev/tty ]; then
        mv /dev/tty /dev/tty.real
    fi
    ln -sf /dev/null /dev/tty
}

_test_teardown() {
    rm -f /dev/tty
    [ -e /dev/tty.real ] && mv /dev/tty.real /dev/tty
}

run_test_scripts() {
    _test_setup
    for dir in /mnt/glibc /mnt/musl; do
        set -- "$dir"/*_testcode.sh
        if [ -f "$1" ]; then
            echo "[init] found test scripts in $dir"
            cd "$dir" || continue
            for script in "$@"; do
                name="${script##*/}"
                if _is_blacklisted "$name"; then
                    echo "[init] skip $name (blacklist)"
                else
                    echo "[init] run $name"
                    /bin/sh "$script"
                fi
            done
        fi
    done
    _test_teardown
    return 0
}

setup_dynamic_linker() {
    glibc_lib=/mnt/glibc/lib

    if [ ! -e /lib ] && [ ! -L /lib ]; then
        ln -s "$glibc_lib" /lib 2>/dev/null || true
    fi
    if [ ! -e /lib64 ] && [ ! -L /lib64 ]; then
        ln -s "$glibc_lib" /lib64 2>/dev/null || true
    fi

    case ":${LD_LIBRARY_PATH:-}:" in
        *:"$glibc_lib":*) ;;
        *) LD_LIBRARY_PATH="$glibc_lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" ;;
    esac
    export LD_LIBRARY_PATH

    echo "[init] dynamic linker path prepared"
}

shutdown_after_tests() {
    sync || true
    poweroff -f >/dev/null 2>&1 || poweroff >/dev/null 2>&1 || reboot -f >/dev/null 2>&1 || true
}

mount -t ext4 /dev/vd0 /mnt 2>/dev/null || true
setup_dynamic_linker
echo "[init] mount testdisk OK (or skipped)"
echo "[init] ls /mnt:"
/bin/ls /mnt/ 2>&1 || true
echo "[init] ls done"

if run_test_scripts; then
    echo "[init] test scripts finished, shutting down"
    shutdown_after_tests
fi

echo "[init] no test scripts found, entering shell"
exec /bin/sh -i
