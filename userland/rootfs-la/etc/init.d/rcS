#!/bin/sh

PATH=/sbin:/bin:/usr/sbin:/usr/bin
export PATH

echo "[init] Welcome to Shiori"

for dir in /dev /sys /proc /run /mnt /tmp; do
    [ -d "$dir" ] || mkdir -p "$dir"
done

mount -t devtmpfs devtmpfs /dev 2>/dev/null || true
mount -t proc proc /proc 2>/dev/null || true
mount -t sysfs sysfs /sys 2>/dev/null || true

if [ -x /sbin/mdev ]; then
    if [ -e /proc/sys/kernel/hotplug ]; then
        echo /sbin/mdev > /proc/sys/kernel/hotplug 2>/dev/null || true
    fi
    /sbin/mdev -s 2>/dev/null || true
fi

ltp_mode=0
if [ -r /sys/kernel/cmdline ]; then
    for arg in $(cat /sys/kernel/cmdline 2>/dev/null); do
        [ "$arg" = "ltp_run=1" ] && ltp_mode=1
    done
fi

# LoongArch64 的 QEMU 直启路径不保证把 -append 传给 EFI stub，因此宿主编排器
# 也会把同一组参数写入工作盘。没有该工作盘或配置文件时不改变普通启动行为。
mkdir -p /ltp-work
if [ -b /dev/vd1 ] && mount -t ext4 /dev/vd1 /ltp-work 2>/dev/null; then
    if grep -qx 'ltp_run=1' /ltp-work/ltp.conf 2>/dev/null; then
        ltp_mode=1
    elif [ "$ltp_mode" -eq 0 ]; then
        umount /ltp-work 2>/dev/null || true
    fi
fi

if [ "$ltp_mode" -eq 1 ]; then
    if ! mount -t ext4 /dev/vd0 /mnt; then
        printf '@@LTP\tfatal\treason=test-image-mount-failed\tdevice=/dev/vd0\n'
        poweroff -f >/dev/null 2>&1 || poweroff >/dev/null 2>&1 || true
        exit 1
    fi
    echo "[init] entering LoongArch64 LTP runner"
    exec /bin/sh /etc/ltp-runner.sh
fi

if mount -t ext4 /dev/vd0 /mnt; then
    echo "[init] mounted /dev/vd0 at /mnt"
    sh_file_list="/tmp/init-sh-files.$$"
    : > "$sh_file_list"

    echo "[init] /mnt directory tree:"
    find /mnt -print 2>/dev/null | sort | while IFS= read -r path; do
        printf '%s\n' "$path"
        case "$path" in
            *.sh)
                if [ -f "$path" ] && [ ! -L "$path" ]; then
                    printf '%s\n' "$path" >> "$sh_file_list"
                fi
                ;;
        esac
    done
    echo "[init] /mnt directory tree end"

    if [ -s "$sh_file_list" ]; then
        echo "[init] shell file contents:"
        while IFS= read -r script; do
            printf '\n[init] ===== %s =====\n' "$script"
            cat "$script" || echo "[init] failed to read $script"
            printf '\n[init] ===== end %s =====\n' "$script"
        done < "$sh_file_list"
    else
        echo "[init] no .sh files found under /mnt"
    fi

    rm -f "$sh_file_list"
else
    echo "[init] failed to mount /dev/vd0 at /mnt"
fi

echo "[init] startup inspection complete"
