#!/bin/sh

PATH=/sbin:/bin:/usr/sbin:/usr/bin
export PATH

echo "[init] Welcome to MyGO!!!!! OS"

for dir in /dev /sys /proc /var /var/log /run /mnt /tmp; do
    [ -d "$dir" ] || mkdir -p "$dir"
    echo "[init] mkdir $dir OK"
done

mount -t proc proc /proc 2>/dev/null || true
echo "[init] mount /proc OK"

mount -t sysfs sysfs /sys 2>/dev/null || true
echo "[init] mount /sys OK"

mount -t devtmpfs devtmpfs /dev 2>/dev/null || true
echo "[init] mount /dev OK"

if [ -x /sbin/mdev ]; then
    if [ -e /proc/sys/kernel/hotplug ]; then
        echo /sbin/mdev > /proc/sys/kernel/hotplug 2>/dev/null || true
    fi
    /sbin/mdev -s 2>/dev/null || true
fi

# 确保 eth0 处于 UP 状态以触发内核 DHCP 自动配置（Auto 接口）。
ip link set eth0 up 2>/dev/null || true

# 等待 DHCP 租约写入 DNS，然后生成 /etc/resolv.conf。
# 内核 DHCP 的 DNS 列表通过 /proc/net/dns 导出（一行一个 nameserver）。
resolv_ready=0
for i in $(seq 1 20); do
    if [ -s /proc/net/dns ]; then
        resolv_ready=1
        break
    fi
    sleep 1
done
if [ "$resolv_ready" = "1" ]; then
    {
        echo "# Generated by MyGO init (DHCP lease)"
        cat /proc/net/dns
    } > /etc/resolv.conf
    echo "[init] /etc/resolv.conf generated from DHCP"
else
    echo "[init] DHCP DNS not available yet; /etc/resolv.conf skipped"
fi

if [ -x /etc/init.d/test.sh ]; then
    /bin/sh /etc/init.d/test.sh
fi

if [ -x /etc/init.d/judge.sh ]; then
    exec /bin/sh /etc/init.d/judge.sh
fi

exec /bin/sh -i
