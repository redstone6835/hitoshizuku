# SOYO Wire ABI 的机器可读注册表。
# generation 改变表示线格式契约发生变化，必须同步更新规范版本。

[meta]
generation = 2

[scalar]
HEADER_SIZE = 192
DIRECTORY_ENTRY_SIZE = 48
IMAGE_SEGMENT_SIZE = 64
ABI_IMPORT_SIZE = 64
CAPABILITY_REQUIREMENT_SIZE = 64
RELOCATION_SIZE = 48
RUNTIME_INFO_SIZE = 96
COMPONENT_INFO_SIZE = 128
COMPONENT_DEPENDENCY_SIZE = 96
SYMBOL_IMPORT_SIZE = 96
SYMBOL_EXPORT_SIZE = 96
DYNAMIC_RELOCATION_SIZE = 48
SIGNATURE_SIZE = 128

[header]
MAGIC = 0x00
FORMAT_VERSION = 0x04
HEADER_SIZE = 0x06
ARTIFACT_KIND = 0x08
TARGET_ARCH = 0x0a
ENDIAN = 0x0c
POINTER_WIDTH = 0x0d
ABI_FAMILY = 0x0e
ABI_EPOCH = 0x10
HASH_ALGORITHM = 0x12
FLAGS = 0x14
REQUIRED_FEATURES = 0x18
OPTIONAL_FEATURES = 0x20
ENTRY_OFFSET = 0x28
TABLE_OFFSET = 0x30
TABLE_COUNT = 0x38
TABLE_ENTRY_SIZE = 0x3c
RESERVED0 = 0x3e
FILE_SIZE = 0x40
IMAGE_VIRTUAL_SIZE = 0x48
BUILD_ID = 0x50
CONTENT_HASH = 0x70
RESERVED1 = 0x90

[directory]
TABLE_TYPE = 0x00
FLAGS = 0x02
ENTRY_SIZE = 0x04
ENTRY_COUNT = 0x08
RESERVED0 = 0x0c
FILE_OFFSET = 0x10
FILE_SIZE = 0x18
ALIGNMENT = 0x20
RESERVED1 = 0x28

[image_segment]
KIND = 0x00
PERMISSIONS = 0x02
FLAGS = 0x04
VIRTUAL_OFFSET = 0x08
FILE_OFFSET = 0x10
FILE_SIZE = 0x18
MEMORY_SIZE = 0x20
ALIGNMENT = 0x28
RESERVED0 = 0x30
RESERVED1 = 0x38

[abi_import]
SLOT = 0x00
OPERATION_ID = 0x04
FLAGS = 0x08
DIAGNOSTIC_NAME_OFFSET = 0x0c
SIGNATURE_HASH = 0x10
RESERVED = 0x30

[capability_requirement]
REQUIREMENT_ID = 0x00
OBJECT_INTERFACE = 0x04
FLAGS = 0x06
REQUIRED_RIGHTS = 0x08
DIAGNOSTIC_NAME_OFFSET = 0x10
RESERVED0 = 0x14
RESERVED1 = 0x18

[relocation]
KIND = 0x00
FLAGS = 0x02
TARGET_SEGMENT_INDEX = 0x04
TARGET_OFFSET = 0x08
SOURCE_SEGMENT_INDEX = 0x10
RESERVED0 = 0x14
ADDEND = 0x18
RESERVED1 = 0x20
RESERVED2 = 0x28

[runtime_info]
STACK_SIZE = 0x00
STACK_GUARD_SIZE = 0x08
RUNTIME_FLAGS = 0x10
INIT_ARRAY_OFFSET = 0x18
INIT_ARRAY_COUNT = 0x20
INIT_ARRAY_ENTRY_SIZE = 0x24
RESERVED0 = 0x26
FINI_ARRAY_OFFSET = 0x28
FINI_ARRAY_COUNT = 0x30
FINI_ARRAY_ENTRY_SIZE = 0x34
RESERVED1 = 0x36
STACK_ALIGNMENT = 0x38
START_INFO_MAX_SIZE = 0x3c
RESERVED2 = 0x40

[component_info]
COMPONENT_ID = 0x00
ABI_ID = 0x10
FLAGS = 0x20
INIT_OFFSET = 0x28
FINI_OFFSET = 0x30
INTERFACE_COUNT = 0x38
RESERVED0 = 0x3c
CALL_STATE_SIZE = 0x40
RESERVED1 = 0x48

[component_dependency]
COMPONENT_ID = 0x00
ABI_ID = 0x10
CONTENT_HASH = 0x20
FLAGS = 0x40
DIAGNOSTIC_NAME_OFFSET = 0x44
RESERVED = 0x48

[symbol_import]
DEPENDENCY_INDEX = 0x00
FLAGS = 0x04
INTERFACE_ID = 0x08
SYMBOL_ID = 0x18
SIGNATURE_HASH = 0x28
DIAGNOSTIC_NAME_OFFSET = 0x48
RESERVED0 = 0x4c
RESERVED1 = 0x50

[symbol_export]
INTERFACE_ID = 0x00
SYMBOL_ID = 0x10
SIGNATURE_HASH = 0x20
ENTRY_OFFSET = 0x40
FLAGS = 0x48
DIAGNOSTIC_NAME_OFFSET = 0x4c
RESERVED = 0x50

[dynamic_relocation]
KIND = 0x00
FLAGS = 0x02
TARGET_SEGMENT_INDEX = 0x04
TARGET_OFFSET = 0x08
SOURCE_INDEX = 0x10
RESERVED0 = 0x14
ADDEND = 0x18
RESERVED1 = 0x20
RESERVED2 = 0x28

[signature]
KEY_ID = 0x00
SIGNATURE = 0x20
FLAGS = 0x60
RESERVED = 0x64
